{# === Системное сообщение (выводим один раз до цикла) === #}
{% if messages | length > 0 and messages[0]['role'] == 'system' %}
{{ messages[0]['content'] }}
{% endif %}

{# === Перебор истории сообщений === #}
{% for message in messages %}
    {# Пропускаем системное сообщение внутри цикла во избежание дублирования #}
    {% if loop.first and message['role'] == 'system' %}
        {% continue %}
    {% endif %}

    {### РОЛЬ: ПОЛЬЗОВАТЕЛЬ ###}
    {% if message['role'] == 'user' %}
<|user|>
{{ message['content'] }}
<|end|>

    {### РОЛЬ: АССИСТЕНТ ###}
    {% elif message['role'] == 'assistant' %}
        {# Блокируем вывод тега, если контент пуст или содержит только пробелы #}
        {% set content = message['content'] | default('') | trim %}
        
        {% if message['tool_calls'] is defined and message['tool_calls'] | length > 0 %}
<|tool_calls>
{{ message['tool_calls'] | tojson(indent=2) }}
</|tool_calls>

        {# Если это обычный текст — очищаем его от любых служебных меток модели #}
        {% elif content != '' %}
<|assistant|>
{{ content 
   | replace('<|assistant|>', '') 
   | replace('<|end|>', '') 
   | replace('<|user|>', '') 
   | replace('<|tool|>', '') 
   | replace('{ "tool"', '\n{ "tool"') }}
<|end|>

        {% endif %}

    {### РОЛЬ: ИНСТРУМЕНТ (ответ сервера) ###}
    {% elif message['role'] == 'tool' %}
<|tool>
{{ message['content'] }}
<|end|>
    {% endif %}
{% endfor %}