# 1. Указываем базовую модель, которую мы настраиваем
FROM hf.co/yandex/YandexGPT-5-Lite-8B-instruct-GGUF:Q4_K_M

# 2. Задаем шаблон запроса (параметры .System, .Prompt, .Response подставляются Ollama автоматически)
TEMPLATE """{{ if .System }}<|system|>
{{ .System }}<|end|>
{{ end }}{{ if .Prompt }}<|user|>
{{ .Prompt }}<|end|>
{{ end }}<|assistant|>
{{ .Response }}<|end|>"""

# 3. Опционально: вшиваем системный промпт по умолчанию
SYSTEM """Ты — полезный ИИ-ассистент. Если тебе доступны инструменты, ты должен использовать их, возвращая результат строго в формате JSON."""

# 4. Опционально: можно настроить параметры контекста или температуры
PARAMETER temperature 0.3
PARAMETER num_ctx 4096

